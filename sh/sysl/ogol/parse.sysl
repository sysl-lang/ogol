module sh.sysl.ogol

import sh.sysl.parsing.{Span, Spanned, TokenStream, Tokens, pratt}
import sysl.buf.{Buf, buf}

// Tokens to a tree.
//
// **Nothing is bracketed, so arity is what holds the grammar together.** `print double count` is read
// by asking `print` how many arguments it takes, then reading that many expressions -- and the first of
// them asks `double` the same question. A name nobody has heard of takes none, which is what a variable
// is, so the rule needs no table of what is bound and no second pass.
//
// **A line is a hard boundary.** Logo lets a command reach across as many lines as its arguments need,
// which is why a Logo console can sit waiting for a word that is never coming and look dead. Here a
// statement ends at the end of its line, and the only two things that may span one are a bracketed
// block and a definition -- both of which are visible in the text, so a console can tell "unfinished"
// from "wrong" and say so.
//
// **The expression half is `sh.sysl.parsing.pratt` and not a function per precedence level.** Four
// functions -- `comparison`, `sum`, `product`, `unary` -- each testing a handful of operators and
// calling the next, are one table of binding powers and two callbacks here. What made that possible is
// that the loop hands its callbacks the *parser* rather than a token cursor: `nud` has to know a name's
// arity before it can read that name's arguments, and the dictionary that answers is a field on
// `Parser`. So `Parser` is the `TokenStream`, and the callbacks reach everything a member would.

// How many arguments each of the built-in names takes. It is the whole vocabulary of the language
// beside the operators: seven names, chosen so that nothing here is a convenience -- take any one away
// and there is a program that can no longer be written.
builtin_arity(name: string) -> Option[usize]
    name match
        "print" -> Some(1)
        "set" -> Some(2)
        "repeat" -> Some(2)
        "if" -> Some(2)
        "ifelse" -> Some(3)
        "stop" -> Some(0)
        "output" -> Some(1)
        // The list surface. **Every one of these works on a word as well as on a list**, which is
        // Logo's rule and not a convenience: a word is a sequence of characters exactly as a list is a
        // sequence of elements, so `first "hello` is `h` and `butfirst [a b c]` is `[b c]`. Writing
        // two families for the two would double the vocabulary to say one thing.
        "first" -> Some(1)
        "last" -> Some(1)
        "butfirst" -> Some(1)
        "bf" -> Some(1)
        "butlast" -> Some(1)
        "bl" -> Some(1)
        // **`count` is deliberately absent, and it is Logo's name for this.** Dropping Logo's sigils
        // means a built-in name cannot also be a variable, and `count` is one of the most natural
        // variable names there is — the README's own first example is `set count 0`. Adding it would
        // make that example an error, which is too high a price for one operation. `emptyp` answers
        // the question people actually ask of a list, and how to spell the length is a decision worth
        // taking deliberately rather than by seizing the obvious word.
        "item" -> Some(2)
        "fput" -> Some(2)
        "lput" -> Some(2)
        "list" -> Some(2)
        "emptyp" -> Some(1)
        "listp" -> Some(1)
        _ -> None
end builtin_arity

// A count with the noun that agrees with it, because a diagnostic reading "1 arguments" undoes some of
// the care that went into the sentence around it.
private arguments(n: usize) -> string = if n == 1 then "1 argument" else s"$n arguments"

// Deep enough for anything written at a keyboard, and shallow enough that the recursive walks below
// cannot run a small stack out. The parser is the only thing that builds a nested tree, so capping it
// here is what bounds evaluation and rendering too.
private const max_depth: usize = 64

// How tightly each operator pulls what is on its left, and 0 for everything that is not one.
//
// **Three levels, and the whole precedence table is these ten lines.** The comparisons bind loosest,
// so `count + 1 > limit` compares the sum; nothing chains, because every one of them is left
// associative and `led` recurses at its own power.
//
// **A minus with a space on its left and none on its right answers 0**, which is what stops the loop
// -- and is the same decision the old `sum` made with a `break`. It is not an operator at all there:
// it opens the next argument, and `pin 15 -1` passes two of them.
private lbp(t: Spanned[Token]) -> u16
    t.value match
        Operator("=") -> 1
        Operator("<>") -> 1
        Operator("<") -> 1
        Operator(">") -> 1
        Operator("<=") -> 1
        Operator(">=") -> 1
        Operator("+") -> 2
        Minus(before, after) -> if before && !after then 0 else 2
        Operator("*") -> 3
        Operator("/") -> 3
        _ -> 0
end lbp

// An operator with the expression it was handed on its left, and whatever it reads on its right.
//
// Every one of Ogol's is left associative, so the recursion is at the operator's own power: a second
// operator of the same strength stops the inner loop and `8 - 4 - 2` is `(8 - 4) - 2`.
private led(left: Result[&Expr, Fault], t: Spanned[Token], s: *Parser) -> Result[&Expr, Fault]
    val l = left?
    val op = t.value match
        Minus(_, _) -> "-"
        Operator(name) -> name
        _ -> ""

    pratt(s, lbp(t), nud, led, lbp) match
        None -> Err(BadAt(s"'$op' needs something after it", t.span))
        Some(right) -> Ok(Binary(op, l, right?))
end led

// A token in prefix position: a literal, a name, a bracket, a negation.
//
// **The depth is counted here and nowhere else**, because this is the one function every nesting goes
// through -- an argument, a parenthesis, a bracket and a negation all reach their contents by coming
// back round to it. The counter is raised on the way in and lowered on the way out, which is why the
// body is a second function: a `?` in it would otherwise leave the count raised.
private nud(t: Spanned[Token], s: *Parser) -> Result[&Expr, Fault]
    if s.depth >= max_depth then return Err(BadAt("that is nested too deeply", t.span))

    s.depth += 1

    val out = nud_at(t, s)

    s.depth -= 1
    out
end nud

private nud_at(t: Spanned[Token], s: *Parser) -> Result[&Expr, Fault]
    t.value match
        Number(n) -> Ok(Literal(Num(n)))
        Quoted(w) -> Ok(Literal(Word(w)))
        Open ->
            val inner = s.expression()?
            val after = s.current()

            after.value match
                Close ->
                    s.bump()
                    Ok(inner)
                Eof -> Err(More)
                _ -> Err(BadAt(s"')' expected, not ${spell(after.value)}", after.span))
        OpenBlock -> s.bracket()
        // Nothing may be negated but an operand, so `- - 1` is refused rather than read as a double
        // negative -- which keeps the one wart in the language to a single rule.
        Minus(_, _) ->
            s.ts.advance() match
                None -> Err(More)
                Some(inner) ->
                    inner.value match
                        Minus(_, _) -> Err(BadAt("'-' needs something in front of it", inner.span))
                        _ -> Ok(Negate(nud(inner, s)?))
        Name("to") -> Err(BadAt("'to' starts a definition and cannot be part of an expression", t.span))
        Name("end") -> Err(BadAt("'end' closes a definition, and there is none open", t.span))
        Name("set") -> s.assignment(t.span)
        Name(n) -> s.call(n, t.span)
        Param(p) -> Err(BadAt(s"':$p' names a parameter, which only a 'to' line may do", t.span))
        Operator(op) -> Err(BadAt(s"'$op' needs something in front of it", t.span))
        Close -> Err(BadAt("')' closes something that was never opened", t.span))
        CloseBlock -> Err(BadAt("']' closes something that was never opened", t.span))
        LineBreak -> Err(BadAt("the line ends before the value it was building", t.span))
        Eof -> Err(More)
end nud_at

private struct Parser
    ts: Tokens[Token]
    procs: &Procs

    // How deep the reader is inside its own recursion. It is a field rather than a parameter because
    // `pratt`'s callbacks are bare arrows and carry nothing of their own -- what they are handed is
    // this parser, so what they need has to be on it.
    depth: usize

    // The token at the cursor. The stream always ends with exactly one `Eof`, so there is always a
    // token; a cursor that has somehow gone past it answers `Eof` again rather than nothing, because
    // every reader below is written against a token rather than against an option.
    private current(self) -> Spanned[Token]
        self.ts.peek() match
            Some(t) -> t
            None -> Spanned(Eof, self.ts.here())

    bump(*self)
        val _ = self.ts.advance()

    // Where a statement may stop. A close bracket and a close paren are in the set because a statement
    // list is read the same way inside a block as at the top level, and the thing that ends it differs.
    private at_terminator(self) -> bool
        self.current().value match
            LineBreak -> true
            Eof -> true
            CloseBlock -> true
            Close -> true
            _ -> false
    end at_terminator

    private skip_breaks(*self)
        loop
            self.current().value match
                LineBreak -> self.bump()
                _ -> break

    arity_of(self, name: string) -> usize
        builtin_arity(name) match
            Some(n) -> n
            None ->
                self.procs.find(name) match
                    Some(p) -> p.arity()
                    None -> 0
    end arity_of

    // One expression, at the loosest binding power.
    //
    // `pratt` answers `None` only where the stream was empty, which cannot happen here -- the lexer
    // ends every stream with an `Eof` and `nud` reads that as a request for more text.
    private expression(*self) -> Result[&Expr, Fault]
        pratt(self, 0, nud, led, lbp) match
            Some(r) -> r
            None -> Err(More)

    // --- Statements -------------------------------------------------------------------------------

    // Every statement up to the token that ends the list, with `to` allowed only where a definition may
    // appear. A block and a procedure body are read by this too, which is what makes a block's contents
    // the same language as a line's.
    private statements(*self, top: bool) -> Result[&Buf[&Expr], Fault]
        var out: &Buf[&Expr] = buf()

        loop
            self.skip_breaks()

            self.current().value match
                Eof -> break
                CloseBlock -> break
                Close -> break
                _ -> ()

            var stmt = self.statement(top)?

            out.push(stmt)
            self.surplus(stmt)?

        Ok(out)
    end statements

    private statement(*self, top: bool) -> Result[&Expr, Fault]
        val head = self.current()

        head.value match
            Name("to") ->
                if !top then
                    return Err(BadAt("'to' starts a definition, which cannot go inside another one",
                                     head.span))

                self.definition()
            _ -> self.expression()
    end statement

    // **What is left on the line after a statement, and the one diagnostic that teaches something.**
    // Arity says how many arguments a command takes, so anything still sitting on the line that is not
    // the start of another command was an argument too many -- and by far the likeliest reason is the
    // space around a minus sign, since `count -1` is two things and `count - 1` is one. The count is
    // reported by reading the surplus rather than by guessing at it, and the caret goes under the
    // surplus rather than under the command, because the surplus is the part to delete.
    private surplus(*self, stmt: &Expr) -> Result[unit, Fault]
        var head = head_of(stmt)

        if head == "" then return Ok(())

        var negative = false

        self.current().value match
            Minus(before, after) -> negative = before && !after
            _ -> ()

        val from = self.ts.mark()
        var extra: usize = 0

        loop
            if self.at_terminator() then break

            self.current().value match
                Name(_) -> break
                _ -> ()

            self.expression()?
            extra += 1

        if extra == 0 then return Ok(())

        var want = self.arity_of(head)
        var note = if negative then
                       " -- '-1' reads as a negative number, and '- 1' as a subtraction"
                   else
                       ""

        Err(BadAt(s"'$head' needs ${arguments(want)}, got ${arguments(want + extra)}$note",
                  self.ts.span_from(from)))
    end surplus

    // `to name :a :b`, its body, and `end`. The definition is entered in the dictionary before the body
    // is read, because the body may call it -- and taken back out if the body turns out not to parse, so
    // that a definition that was refused is one the language has never heard of.
    private definition(*self) -> Result[&Expr, Fault]
        self.bump()

        val titled = self.current()
        var name = ""

        titled.value match
            Name(n) -> name = n
            _ -> return Err(BadAt(s"'to' needs a name, not ${spell(titled.value)}", titled.span))

        self.bump()

        if builtin_arity(name).is_some() then
            return Err(BadAt(s"'$name' is built in and cannot be redefined", titled.span))

        var params: &Buf[string] = buf()

        loop
            self.current().value match
                Param(p) ->
                    params.push(p)
                    self.bump()
                _ -> break

        var previous = self.procs.find(name)
        var p: &Proc = Proc(name, params, buf())

        self.procs.define(p)

        var body = self.body()

        body match
            Ok(b) ->
                p.body = b
                Ok(Define(p))
            Err(f) ->
                previous match
                    Some(old) -> self.procs.define(old)
                    None -> self.procs.forget(name)

                Err(f)
    end definition

    private body(*self) -> Result[&Buf[&Expr], Fault]
        var out: &Buf[&Expr] = buf()

        loop
            self.skip_breaks()

            self.current().value match
                Eof -> return Err(More)
                Name("end") ->
                    self.bump()
                    break
                _ -> ()

            var stmt = self.statement(false)?

            out.push(stmt)
            self.surplus(stmt)?

        Ok(out)
    end body

    // --- Expressions ------------------------------------------------------------------------------

    // `set count 0`. The target is a name rather than a value, which is why this is not an ordinary
    // call -- everything else in the language evaluates every argument it is given.
    private assignment(*self, at: Span) -> Result[&Expr, Fault]
        val named = self.current()
        var target = ""

        named.value match
            Name(n) -> target = n
            Param(p) ->
                return Err(BadAt(s"write 'set $p', not 'set :$p' -- the colon is for a 'to' line",
                                 named.span))
            _ -> return Err(BadAt(s"'set' needs a name to set, not ${spell(named.value)}", named.span))

        self.bump()

        if builtin_arity(target).is_some() then
            return Err(BadAt(s"'$target' is built in and cannot be used as a variable", named.span))

        Ok(Assign(target, self.expression()?))
    end assignment

    private call(*self, name: string, at: Span) -> Result[&Expr, Fault]
        var want = self.arity_of(name)
        var args: &Buf[&Expr] = buf()

        for i in 0..<want
            if self.at_terminator() then
                return Err(BadAt(s"'$name' needs ${arguments(want)}, got ${arguments(i)}", at))

            args.push(self.expression()?)

        Ok(Call(name, args))
    end call

    // `[ … ]`, which is **two things at once and has to be read as both**.
    //
    // Logo has one aggregate and one bracket: `[a b c]` is a list of unevaluated words, and `repeat 3
    // [ print 1 ]` is the same list handed to something that runs it. Ogol read only the second of
    // those, so `print [sdfg dfgh]` was refused -- a block was "something to run, not a value".
    //
    // **So the run is read twice, and both readings are kept.** The datum reading always succeeds, and
    // is what `print` and every list operation see. The statement reading is attempted over the same
    // tokens and is what `repeat`, `if` and `ifelse` demand; when it fails, the failure is carried
    // rather than raised, so `[+]` is a list until somebody tries to run it and then reports the
    // error the parser already had.
    //
    // Reading twice rather than converting one to the other is what keeps both honest: a datum built
    // from statements could not hold `[a b c]`, whose words are calls to nothing, and statements
    // rebuilt from a datum would have to re-lex text this parser already has as tokens.
    //
    // **The cursor is put back by hand and the depth is not**, which is worth saying because the
    // second looks like an omission. This is the one refusal the reader catches and carries on from,
    // so a depth counter that leaked a level per bracket would refuse the sixty-fifth of them -- and
    // it cannot leak, because `nud` and `datum` each lower the count in a wrapper their `?` cannot
    // escape. `tests.sysl` pins that with eighty brackets whose bodies do not parse.
    private bracket(*self) -> Result[&Expr, Fault]
        val start = self.ts.mark()
        val items = self.datum()?
        val after = self.ts.mark()

        // The same tokens again, as code. A `More` cannot arise here -- the datum reading above only
        // returns once it has seen the closing bracket -- so anything this refuses is a real fault,
        // and it is held rather than thrown.
        self.ts.reset(start)

        var body: &Buf[&Expr] = buf()
        var why = ""

        while why == ""
            self.skip_breaks()

            self.current().value match
                Eof -> why = "the block does not end"
                CloseBlock -> break
                Close -> why = "')' cannot close a '['"
                _ ->
                    self.statement(false) match
                        Err(f) -> why = describe(f)
                        Ok(stmt) ->
                            self.surplus(stmt) match
                                Err(f) -> why = describe(f)
                                Ok(_) -> body.push(stmt)

        self.ts.reset(after)

        Ok(Bracket(items, body, why))
    end bracket

    // The bracketed run as **data**: every token as the word it was written, and a nested `[ ]` as a
    // list element of its own.
    //
    // **An operator is a word here**, which is what lets a list hold the text of a program: `[set n n
    // + 1]` is six elements, one of them `+`. Logo has always read them this way, and it is the same
    // reason a list can be `run`.
    //
    // A line break inside a bracket is not an element -- a list may be written across as many lines as
    // it likes, which is one of the two things Ogol lets span a line.
    private datum(*self) -> Result[&Buf[Value], Fault]
        if self.depth >= max_depth then
            return Err(BadAt("these brackets are nested too deeply", self.current().span))

        self.depth += 1

        val out = self.datum_at()

        self.depth -= 1
        out
    end datum

    private datum_at(*self) -> Result[&Buf[Value], Fault]
        var out: &Buf[Value] = buf()

        loop
            val t = self.current()

            t.value match
                Eof -> return Err(More)
                CloseBlock ->
                    self.bump()
                    return Ok(out)
                Close -> return Err(BadAt("')' cannot close a '['", t.span))
                LineBreak -> self.bump()
                OpenBlock ->
                    self.bump()

                    val inner = self.datum()?

                    out.push(List(inner))
                Number(n) ->
                    self.bump()
                    out.push(Num(n))
                _ ->
                    self.bump()
                    out.push(Word(spell(t.value)))
    end datum_at
end Parser

// The parser is the token stream the expression loop runs over, which is what lets `nud` and `led`
// reach the procedure dictionary and the depth counter through the `*S` they are handed.
impl TokenStream for Parser
    type Token = Spanned[Token]

    look(self) -> Option[Spanned[Token]] = self.ts.peek()

    take(*self) -> Option[Spanned[Token]] = self.ts.advance()

// The name a statement is headed by, or the empty string where it is not headed by one. It is what a
// surplus is reported against, and an expression that is nobody's call has nothing to report against.
private head_of(e: &Expr) -> string
    *e match
        Call(name, _) -> name
        Assign(_, _) -> "set"
        _ -> ""

// A whole source text as the statements it holds, against a dictionary the definitions in it are added
// to. The dictionary is the caller's rather than the parser's because reading and running are separate
// steps and both need it -- and because in a console the text arrives one line at a time, with
// everything the previous lines defined still standing.
parse(text: string, into: &Procs) -> Result[&Buf[&Expr], Fault]
    var p = Parser(tokens(text)?, into, 0)
    var out = p.statements(true)?

    // A statement list stops at whatever might have opened it, so a closer with nothing above it
    // reaches here rather than being refused where it was read. Both are named outright, because
    // "unexpected ']'" is a description of the parser's state and not of the reader's mistake.
    val last = p.current()

    last.value match
        Eof -> Ok(out)
        CloseBlock -> Err(BadAt("']' closes something that was never opened", last.span))
        Close -> Err(BadAt("')' closes something that was never opened", last.span))
        _ -> Err(BadAt(s"${spell(last.value)} has nothing to close", last.span))
end parse
