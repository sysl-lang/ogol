module sh.sysl.ogol

import sh.sysl.parsing.{ByteSet, Scanner, Span, Spanned, Tokens, byte_set_of, is_digit, point,
                        read_digits, scanner_of, tokens_of}
import sysl.buf.{Buf, buf}

// Text to tokens.
//
// **The cursor is `sh.sysl.parsing`'s and not this file's.** A byte cursor with lookahead, marks and
// spans is the same in every grammar, and what is left here is only what is Ogol's: which bytes end a
// word, what the tokens are, and the three decisions below that no general scanner could make.
//
// The grammar is Logo's and is nearly all decidable from one byte: `"` opens a word, a digit opens a
// number, and anything else runs to the next delimiter and is a name. Three things are not.
//
// **`:` marks a parameter being declared, and nothing else.** Logo writes it on every read as well --
// `:n` for the value of `n` -- and Ogol does not, because one spelling for a name is easier to type and
// easier to explain. What the colon is still needed for is the title line: `to double :n output n * 2
// end` has to be readable in one pass, and with a bare `n` there is nothing to say where the parameter
// list stops and the body starts. So it survives at the one place it is load bearing, and is refused
// everywhere else.
//
// **A newline is a token.** Logo lets a command run over as many lines as its arguments need, and pays
// for it with a console that can sit forever waiting for an argument that was never coming. Ogol ends
// a command at the end of the line, so the token stream has to say where those are -- which is also
// what makes the continuation prompt honest: the only way to be in the middle of anything at a
// newline is to have an open bracket or an unfinished definition, and both are visible.
//
// **A minus carries the whitespace around it**, because that is what says which minus it is. `pin 15
// -1` passes two arguments and `pin 15 - 1` passes one, and no amount of looking at the tokens either
// side can tell them apart afterwards. So the spacing is recorded here, at the only moment it is
// known, and the parser reads it.

enum Token
    Number(n: long)
    Quoted(s: string)
    Param(s: string)
    Name(s: string)
    Operator(s: string)
    Minus(spaced_before: bool, spaced_after: bool)
    Open
    Close
    OpenBlock
    CloseBlock
    LineBreak
    Eof
end Token

// A token as it was written, for a diagnostic that has to quote what it found.
spell(t: Token) -> string
    t match
        Number(n) -> str(n)
        Quoted(s) -> s"\"$s"
        Param(s) -> s":$s"
        Name(s) -> s
        Operator(s) -> s
        Minus(_, _) -> "-"
        Open -> "("
        Close -> ")"
        OpenBlock -> "["
        CloseBlock -> "]"
        LineBreak -> "the end of the line"
        Eof -> "the end of the input"
end spell

// What ends a bare run of characters, and which bytes are single-character operators.
//
// The four arithmetic signs are in the delimiter set, which is what makes `n-1` three tokens rather
// than one name -- and is the reason a procedure's name may not carry a hyphen.
//
// **They are tables rather than chains of comparisons**, which is what a `ByteSet` is for: four words
// and one shift-and-test per byte, where the eleven `||` this replaced was eleven branches on every
// character of every name.
//
// **AND THEY ARE FIELDS ON THE LEXER RATHER THAN MODULE-LEVEL `val`s, WHICH IS NOT A STYLE CHOICE.** A
// module-level binding is *module storage*, filled by an initializer before a program's statements
// run -- and a `build-c` archive for a freestanding target has no entry point and no loader to run
// one, so an `@export("main")` reaching one is refused outright. That is every board this language
// exists for. `private const` is not the way out either: `byte_set_of(...)` is a call, and a call is
// "not a constant expression". So the sets are built once per `tokens` call, which is sixteen and six
// iterations of a shift-and-or -- nothing beside lexing the line they are built for.
private struct Sets
    delimiters: ByteSet
    operators: ByteSet

// The single-character operators. The two-character ones are matched before these, so that `<=` is
// never read as `<` and then `=`.
private sets() -> Sets = Sets(byte_set_of(" \t\n\r()[]+-*/=<>;"), byte_set_of("+*/=<>"))

// The largest value a `Number` can hold. It is written as a `val` with its type on it because the
// literal is larger than an `int` and cannot be one.
private val number_max: ulong = 9223372036854775807

private struct Lexer
    text: string
    s: Scanner
    sets: Sets

    // The byte before the cursor, which is the one thing a forward cursor cannot be asked for and the
    // one thing the minus rule needs. It is a look at the input rather than a move, so it is here
    // rather than in the scanner.
    private previous(self) -> Option[u8]
        if self.s.offset == 0 then None else Some(self.text.bytes[self.s.offset - 1])

    // Blanks and comments, which are the two things that separate tokens without being one. A newline
    // is neither -- it is a token here -- so this stops at one.
    skip_blanks(*self)
        loop
            self.s.skip_blanks()

            if !self.s.accept(u8(';')) then break

            self.s.skip_to_line_end()
    end skip_blanks

    // Whether the byte before the cursor leaves an operand behind it. A bracket does not, which is why
    // it counts as space: `(-1)` and `( -1)` should not be different programs.
    private spaced_before(self) -> bool
        self.previous() match
            None -> true
            Some(c) -> is_break(c) || c == u8('(') || c == u8('[')

    private spaced_after(self) -> bool
        self.s.peek_at(1) match
            None -> true
            Some(c) -> is_break(c)

    // A run up to the next delimiter, as the text it was written with.
    private run_to_delimiter(*self) -> string
        val from = self.s.offset

        self.s.skip_until_set(self.sets.delimiters)
        self.text[from..<self.s.offset]

    // `12x` is one token and a malformed one, not a number beside a name. The check costs a byte of
    // lookahead and turns a silent misreading into a sentence.
    //
    // **The overflow bound is the type's and not a digit count.** Reading it here used to stop at
    // eighteen digits, because nineteen sometimes fit and sometimes do not; `read_digits` carries the
    // test that asks whether the multiply and the add would fit before doing them, so the answer is
    // now the real one and a nineteen-digit number that fits is a number.
    private read_number(*self) -> Result[Token, Fault]
        val from = self.s.offset

        read_digits(&self.s, 10) match
            Err(_) -> return Err(BadAt("that number is too large", self.s.span_from(from)))
            Ok(v) ->
                if v > number_max then
                    return Err(BadAt("that number is too large", self.s.span_from(from)))

                self.s.peek() match
                    Some(c) ->
                        if !self.sets.delimiters.has(c) then
                            return Err(BadAt(s"'${self.text[self.s.offset..<self.s.offset + 1]}' cannot follow a number",
                                             self.s.here()))
                    None -> ()

                Ok(Number(long(v)))
    end read_number

    next(*self) -> Result[Spanned[Token], Fault]
        self.skip_blanks()

        val from = self.s.offset

        if self.s.at_end() then return Ok(Spanned(Eof, point(from)))

        val here = self.token(from)?

        Ok(Spanned(here, self.s.span_from(from)))
    end next

    private token(*self, from: usize) -> Result[Token, Fault]
        if self.s.accept_newline() then return Ok(LineBreak)

        if self.s.accept(u8('(')) then return Ok(Open)

        if self.s.accept(u8(')')) then return Ok(Close)

        if self.s.accept(u8('[')) then return Ok(OpenBlock)

        if self.s.accept(u8(']')) then return Ok(CloseBlock)

        if self.s.accept(u8('"')) then return Ok(Quoted(self.run_to_delimiter()))

        if self.s.accept(u8(':'))
            val name = self.run_to_delimiter()

            if name == "" then
                return Err(BadAt("':' needs a parameter name after it", self.s.span_from(from)))

            return Ok(Param(name))

        // The one token whose meaning is in the space around it, recorded before the cursor moves off
        // it. `x- y` is the shape with no reading at all -- a binary minus is written with space on
        // both sides or neither -- so it is refused here rather than parsed into something nobody
        // meant.
        if self.s.peek() == Some(u8('-'))
            val before = self.spaced_before()
            val after = self.spaced_after()

            self.s.bump()

            if !before && after then
                return Err(BadAt("'-' is written '- ' with a space each side to subtract, or '-' with none",
                                 self.s.span_from(from)))

            return Ok(Minus(before, after))

        self.s.peek() match
            Some(c) ->
                if is_digit(c) then return self.read_number()
            None -> ()

        if self.s.accept_seq("<=".bytes) then return Ok(Operator("<="))

        if self.s.accept_seq("<>".bytes) then return Ok(Operator("<>"))

        if self.s.accept_seq(">=".bytes) then return Ok(Operator(">="))

        if self.s.accept_set(self.sets.operators) then return Ok(Operator(self.text[from..<self.s.offset]))

        Ok(Name(self.run_to_delimiter()))
    end token
end Lexer

// Either byte of a line ending, or a blank. It is what "there is space here" means to the minus rule,
// and it is one function rather than four comparisons written twice.
private is_break(c: u8) -> bool = c == u8(' ') || c == u8('\t') || c == u8('\n') || c == u8('\r')

// Every token in a source text, ending with exactly one `Eof`, each with the span it was written at.
//
// The whole text is tokenized before anything is parsed, because the parser has to look ahead a token
// to decide what a minus is and how far an argument reaches, and a stream that could fail on the
// lookahead would put a lexical error in the middle of a syntactic decision.
tokens(text: string) -> Result[Tokens[Token], Fault]
    var lx = Lexer(text, scanner_of(text), sets())
    var out: Buf[Spanned[Token]] = buf()

    loop
        val t = lx.next()?

        out.push(t)

        t.value match
            Eof -> break
            _ -> ()

    Ok(tokens_of(out))
end tokens
