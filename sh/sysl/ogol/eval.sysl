module sh.sysl.ogol

import sysl.buf.{Buf, buf}
import sysl.text.str_builder

// Running the tree.
//
// **An interpreter, not an evaluator**: the state is the point. What Ogol exists for is a session at a
// keyboard, where a procedure defined an hour ago is still there and a variable still holds what the
// last line put in it -- so the dictionary and the bindings outlive any one line, and `run` is a thing
// done *to* an interpreter rather than a function of its text.

// A call's own bindings. Only parameters land here: Ogol has no local declaration, so a `set` inside a
// procedure reaches whatever the name already means, which is the parameter where there is one and the
// global where there is not.
struct Frame
    names: &Buf[string]
    vals: &Buf[Value]

    find(self, name: string) -> Option[usize]
        for i in 0..<self.names.len()
            if self.names.at(i) == name then return Some(i)

        None
    end find
end Frame

frame() -> &Frame = Frame(buf(), buf())

// How deep a procedure may call itself. Ogol's recursion is sysl's -- a call runs a call -- so the
// limit is really the machine's stack, and a number well under it is what turns a program that would
// have taken the board down into a sentence about the program.
private const max_calls: int = 128

struct Ogol
    globals: &Frame
    frames: &Buf[&Frame]
    procs: &Procs
    out: &Buf[string]

    // Whether a line's output is also written to the console as it is produced. A session wants it and
    // a test does not, and the transcript is kept either way -- which is what lets a test read what a
    // program printed without a serial port in the middle of it.
    quiet: bool

    // Set by `stop` and by `output`, and read by every statement list on the way out. It is a field
    // rather than a value threaded through the walk because every one of the four places that has to
    // notice it is a loop, and a loop that has to unpack a return value to find out whether to keep
    // going is the shape this replaces.
    returning: bool
    answer: Value

    depth: int
end Ogol

ogol() -> &Ogol = Ogol(frame(), buf(), procs(), buf(), false, false, Nothing, 0)

// Everything the interpreter has printed since it was made, which is what a test reads instead of a
// serial line.
transcript(i: &Ogol) -> string
    var out = ""

    for k in 0..<i.out.len()
        if k > 0 then out = out + "\n"
        out = out + i.out.at(k)

    out
end transcript

// The frame a name is looked up in first: the innermost call's, where there is one. Ogol has one level
// of locals rather than Logo's dynamic chain -- a procedure sees its own parameters and the globals,
// and nothing of whoever called it. That is a departure, and it is the one that makes a procedure
// readable on its own.
private innermost(i: &Ogol) -> &Frame =
    if i.frames.len() == 0 then i.globals else i.frames.at(i.frames.len() - 1)

lookup(i: &Ogol, name: string) -> Option[Value]
    var f = innermost(i)

    f.find(name) match
        Some(k) -> return Some(f.vals.at(k))
        None -> ()

    i.globals.find(name) match
        Some(k) -> Some(i.globals.vals.at(k))
        None -> None
end lookup

// `set` writes where the name already lives, and makes it a global where it lives nowhere. That is
// Logo's rule, and the reason for it is that a procedure setting a name its caller can see is how a
// language with no other data structure keeps a running total.
assign(i: &Ogol, name: string, v: Value)
    var f = innermost(i)

    f.find(name) match
        Some(k) ->
            f.vals.set(k, v)
            return
        None -> ()

    i.globals.find(name) match
        Some(k) -> i.globals.vals.set(k, v)
        None ->
            i.globals.names.push(name)
            i.globals.vals.push(v)
end assign

// --- Arithmetic ---------------------------------------------------------------------------------

private number(v: Value, op: string, side: string) -> Result[long, Fault]
    v match
        Num(n) -> Ok(n)
        _ -> Err(Bad(s"'$op' works on numbers, and the $side side is ${kind(v)}"))
end number

private boolean(v: Value, what: string) -> Result[bool, Fault]
    v match
        Bool(b) -> Ok(b)
        _ -> Err(Bad(s"$what needs a true or a false, and got ${kind(v)}"))
end boolean

// The comparisons that order values, which is a narrower question than equality: `=` answers for any
// two values because "these are not the same thing" is always true of two different kinds, and there
// is no answer at all to whether a word comes before a boolean.
private ordered(op: string, a: Value, b: Value) -> Result[Value, Fault]
    var x = number(a, op, "left")?
    var y = number(b, op, "right")?

    op match
        "<" -> Ok(Bool(x < y))
        ">" -> Ok(Bool(x > y))
        "<=" -> Ok(Bool(x <= y))
        _ -> Ok(Bool(x >= y))
end ordered

private arithmetic(op: string, a: Value, b: Value) -> Result[Value, Fault]
    var x = number(a, op, "left")?
    var y = number(b, op, "right")?

    op match
        "+" -> Ok(Num(x + y))
        "-" -> Ok(Num(x - y))
        "*" -> Ok(Num(x * y))
        _ ->
            if y == 0 then return Err(Bad("that divides by zero"))

            Ok(Num(x / y))
end arithmetic

// --- Evaluation ---------------------------------------------------------------------------------

// A value the caller can use, refusing the absence a command answers with. Nearly every mistake a
// beginner makes in Logo is this one -- writing a command where an operation was wanted -- so it is
// worth a sentence that names both halves rather than a complaint about a type.
private wants_value(v: Value, what: string) -> Result[Value, Fault]
    v match
        Nothing -> Err(Bad(s"$what needs a value, and what it was given produces none"))
        _ -> Ok(v)
end wants_value

eval(i: &Ogol, e: &Expr) -> Result[Value, Fault]
    *e match
        Literal(v) -> Ok(v)

        Negate(inner) ->
            var v = eval(i, inner)?

            v match
                Num(n) -> Ok(Num(-n))
                _ -> Err(Bad(s"'-' negates a number, and that is ${kind(v)}"))

        Binary(op, left, right) ->
            var a = wants_value(eval(i, left)?, s"'$op'")?
            var b = wants_value(eval(i, right)?, s"'$op'")?

            op match
                "=" -> Ok(Bool(same(a, b)))
                "<>" -> Ok(Bool(!same(a, b)))
                "<" -> ordered(op, a, b)
                ">" -> ordered(op, a, b)
                "<=" -> ordered(op, a, b)
                ">=" -> ordered(op, a, b)
                _ -> arithmetic(op, a, b)

        Assign(name, value) ->
            assign(i, name, wants_value(eval(i, value)?, s"'set $name'")?)
            Ok(Nothing)

        Define(p) ->
            i.procs.define(p)
            Ok(Nothing)

        // **A bracket is a list**, and that is the whole of Logo's one aggregate. It used to be
        // refused here — "something to run, not a value" — which made `print [hello there]`
        // unwritable and left the language with no way to hold more than one thing at a time.
        Bracket(items, _, _) -> Ok(List(items))

        Call(name, args) -> call(i, name, args)
end eval

// Every statement in a list, stopping the moment something says it is leaving. The value is the last
// statement's, which is what makes a console able to echo a line that ended in an operation.
run_body(i: &Ogol, body: &Buf[&Expr]) -> Result[Value, Fault]
    var last: Value = Nothing

    for k in 0..<body.len()
        if i.returning then break

        last = eval(i, body.at(k))?

    Ok(last)
end run_body

// ## The sequence operations, over a list or a word alike
//
// **A word's elements are its characters**, so every one of these has two arms and they mean the same
// thing. Ogol holds a word as text rather than as a list of one-character words, so the two arms are
// written out rather than one being defined in terms of the other — which would cost a list of
// characters on every call, on a board, to save six lines here.

// The single argument almost all of these take, evaluated and insisted on being a value.
private one(i: &Ogol, args: &Buf[&Expr]) -> Result[Value, Fault]
    wants_value(eval(i, args.at(0))?, "this")

// The character at `k` of a word, as a word of its own.
private char_word(s: string, k: usize) -> Value
    var out = str_builder()
    var n: usize = 0

    for c in s.chars
        if n == k then out.push_char(c)
        n += 1

    Word(out.finish())
end char_word

private first_of(v: Value) -> Result[Value, Fault]
    v match
        List(items) ->
            if items.is_empty() then return Err(Bad("'first' of an empty list"))

            Ok(items.at(0))
        Word(s) ->
            if s == "" then return Err(Bad("'first' of an empty word"))

            Ok(char_word(s, 0))
        _ -> Err(Bad(s"'first' needs a list or a word, not ${kind(v)}"))
end first_of

private last_of(v: Value) -> Result[Value, Fault]
    v match
        List(items) ->
            if items.is_empty() then return Err(Bad("'last' of an empty list"))

            Ok(items.at(items.len() - 1))
        Word(s) ->
            if s == "" then return Err(Bad("'last' of an empty word"))

            Ok(char_word(s, s.chars.count() - 1))
        _ -> Err(Bad(s"'last' needs a list or a word, not ${kind(v)}"))
end last_of

// **Everything but the first**, which is the half of Logo's pair that walks a sequence. `butfirst` of
// a one-element sequence is the empty one rather than an error: that is what ends a loop.
private but_first_of(v: Value) -> Result[Value, Fault]
    v match
        List(items) ->
            if items.is_empty() then return Err(Bad("'butfirst' of an empty list"))

            var out: &Buf[Value] = buf()

            for k in 1..<items.len() do out.push(items.at(k))
            Ok(List(out))
        Word(s) ->
            if s == "" then return Err(Bad("'butfirst' of an empty word"))

            Ok(Word(drop_chars(s, 1, s.chars.count())))
        _ -> Err(Bad(s"'butfirst' needs a list or a word, not ${kind(v)}"))
end but_first_of

private but_last_of(v: Value) -> Result[Value, Fault]
    v match
        List(items) ->
            if items.is_empty() then return Err(Bad("'butlast' of an empty list"))

            var out: &Buf[Value] = buf()

            for k in 0..<items.len() - 1 do out.push(items.at(k))
            Ok(List(out))
        Word(s) ->
            if s == "" then return Err(Bad("'butlast' of an empty word"))

            Ok(Word(drop_chars(s, 0, s.chars.count() - 1)))
        _ -> Err(Bad(s"'butlast' needs a list or a word, not ${kind(v)}"))
end but_last_of

// The characters of `s` from `from` up to `until`, gathered back into a word. Counted in characters
// rather than bytes, so a word with an accent in it does not lose half of one.
private drop_chars(s: string, from: usize, until: usize) -> string
    var out = str_builder()
    var n: usize = 0

    for c in s.chars
        if n >= from && n < until then out.push_char(c)
        n += 1

    out.finish()
end drop_chars

private item_of(n: long, v: Value) -> Result[Value, Fault]
    if n < 1 then return Err(Bad(s"'item' counts from 1, and was asked for $n"))

    val k = usize(n - 1)

    v match
        List(items) ->
            if k >= items.len() then
                return Err(Bad(s"'item' was asked for $n of a list of ${items.len()}"))

            Ok(items.at(k))
        Word(s) ->
            if k >= s.chars.count() then
                return Err(Bad(s"'item' was asked for $n of a word of ${s.chars.count()}"))

            Ok(char_word(s, k))
        _ -> Err(Bad(s"'item' needs a list or a word, not ${kind(v)}"))
end item_of

// What `repeat`, `if` and `ifelse` demand: a bracket that read as statements.
//
// **The parser's own sentence is what comes back when it did not**, rather than a fresh one from
// here. `repeat 3 [+]` is a bracket the datum reading accepted and the statement reading refused, and
// the refusal is worth more than "this is not runnable" — it says what was wrong with the `+`.
private block_of(e: &Expr, what: string) -> Result[&Buf[&Expr], Fault]
    *e match
        Bracket(_, body, why) -> if why == "" then Ok(body) else Err(Bad(why))
        _ -> Err(Bad(s"$what needs a '[ ]' block"))
end block_of

private call(i: &Ogol, name: string, args: &Buf[&Expr]) -> Result[Value, Fault]
    builtin_arity(name) match
        Some(_) -> return builtin(i, name, args)
        None -> ()

    // A name with no arguments is a variable before it is anything else, which is the whole of what
    // dropping Logo's `:` costs: one lookup, in one order, stated here.
    if args.len() == 0
        lookup(i, name) match
            Some(v) -> return Ok(v)
            None -> ()

    i.procs.find(name) match
        Some(p) -> apply(i, p, args)
        None -> Err(Bad(s"I do not know '$name'"))
end call

private apply(i: &Ogol, p: &Proc, args: &Buf[&Expr]) -> Result[Value, Fault]
    if i.depth >= max_calls then
        return Err(Bad(s"'${p.name}' has called itself ${max_calls} deep, which is further than this " +
                       "can follow"))

    // The parser reads a call at the arity the dictionary held when the line was read, so this can
    // only disagree if the procedure was redefined in between. It is checked rather than trusted
    // because the alternative is an index past the end of the parameter list.
    if args.len() != p.params.len() then
        return Err(Bad(s"'${p.name}' has been redefined and now takes a different number of things"))

    var f = frame()

    for k in 0..<args.len()
        f.names.push(p.params.at(k))
        f.vals.push(wants_value(eval(i, args.at(k))?, s"'${p.name}'")?)

    i.frames.push(f)
    i.depth += 1

    var done = run_body(i, p.body)

    i.frames.pop()
    i.depth -= 1

    // The signal is cleared here and nowhere else, because a `stop` leaves *one* procedure. Clearing
    // it in `run_body` would make it leave the innermost block instead, which is a different language.
    var answer: Value = Nothing

    if i.returning
        answer = i.answer
        i.returning = false
        i.answer = Nothing

    done?

    Ok(answer)
end apply

private builtin(i: &Ogol, name: string, args: &Buf[&Expr]) -> Result[Value, Fault]
    name match
        "print" ->
            var v = wants_value(eval(i, args.at(0))?, "'print'")?
            var line = render(v)

            i.out.push(line)
            if !i.quiet then print(line)

            Ok(Nothing)

        "stop" ->
            i.returning = true
            i.answer = Nothing
            Ok(Nothing)

        // ## The list surface
        //
        // **A word is a sequence too**, so each of these answers for both: `first "hello` is `h` and
        // `first [a b c]` is `a`. That is Logo's rule, and it halves the vocabulary without costing
        // any clarity — the operation is "the first of a sequence", and a word is one.
        //
        // A number is *not* a sequence here. Logo would read `first 123` as `1` by treating the number
        // as its own text; Ogol keeps numbers and words apart on purpose (see `Value`), so asking for
        // the first of a number is a mistake and says so.

        "first" -> first_of(one(i, args)?)
        "last" -> last_of(one(i, args)?)
        "butfirst" -> but_first_of(one(i, args)?)
        "bf" -> but_first_of(one(i, args)?)
        "butlast" -> but_last_of(one(i, args)?)
        "bl" -> but_last_of(one(i, args)?)

        // **One-based**, which is Logo's and is the right answer for a language people meet before
        // they meet any other. `item 0` says so rather than reading as the last element or as an
        // empty answer.
        "item" ->
            val n = number(eval(i, args.at(0))?, "item", "left")?
            val v = wants_value(eval(i, args.at(1))?, "'item'")?

            item_of(n, v)

        // `fput` puts one element on the front and `lput` on the back. Both answer a **new** list:
        // nothing in Ogol mutates a value, so a name still holds what it held.
        "fput" ->
            val head = wants_value(eval(i, args.at(0))?, "'fput'")?
            val rest = wants_value(eval(i, args.at(1))?, "'fput'")?

            rest match
                List(items) ->
                    var out: &Buf[Value] = buf()

                    out.push(head)
                    for k in 0..<items.len() do out.push(items.at(k))
                    Ok(List(out))
                _ -> Err(Bad(s"'fput' needs a list to put onto, not ${kind(rest)}"))

        "lput" ->
            val tail = wants_value(eval(i, args.at(0))?, "'lput'")?
            val rest = wants_value(eval(i, args.at(1))?, "'lput'")?

            rest match
                List(items) ->
                    var out: &Buf[Value] = buf()

                    for k in 0..<items.len() do out.push(items.at(k))
                    out.push(tail)
                    Ok(List(out))
                _ -> Err(Bad(s"'lput' needs a list to put onto, not ${kind(rest)}"))

        // Two values as a list of two. Logo's `list` takes exactly two for the same reason everything
        // else here does: arity is what lets the grammar go without brackets, so a variadic name
        // could not be read.
        "list" ->
            val a = wants_value(eval(i, args.at(0))?, "'list'")?
            val b = wants_value(eval(i, args.at(1))?, "'list'")?

            var out: &Buf[Value] = buf()

            out.push(a)
            out.push(b)
            Ok(List(out))

        "emptyp" ->
            val v = one(i, args)?

            v match
                List(items) -> Ok(Bool(items.is_empty()))
                Word(s) -> Ok(Bool(s == ""))
                _ -> Err(Bad(s"'emptyp' needs a list or a word, not ${kind(v)}"))

        "listp" ->
            val v = one(i, args)?

            v match
                List(_) -> Ok(Bool(true))
                _ -> Ok(Bool(false))

        "output" ->
            i.answer = wants_value(eval(i, args.at(0))?, "'output'")?
            i.returning = true
            Ok(Nothing)

        "repeat" ->
            var n = eval(i, args.at(0))?
            var count = number(n, "repeat", "left")?
            var body = block_of(args.at(1), "'repeat'")?

            var k: long = 0

            while k < count && !i.returning
                run_body(i, body)?
                k += 1

            Ok(Nothing)

        "if" ->
            var test = boolean(eval(i, args.at(0))?, "'if'")?
            var body = block_of(args.at(1), "'if'")?

            if test then run_body(i, body)?

            Ok(Nothing)

        _ ->
            var test = boolean(eval(i, args.at(0))?, "'ifelse'")?
            var yes = block_of(args.at(1), "'ifelse'")?
            var no = block_of(args.at(2), "'ifelse'")?

            run_body(i, if test then yes else no)?

            Ok(Nothing)
end builtin

// One piece of source, read and run against everything the interpreter already knows. The value is the
// last statement's, so a console has something to echo and a test has something to assert on.
run(i: &Ogol, src: string) -> Result[Value, Fault]
    var body = parse(src, i.procs)?

    i.returning = false
    i.answer = Nothing

    run_body(i, body)
end run
